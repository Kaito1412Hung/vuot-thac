# Chép thành file .env rồi đổi các giá trị. Tuyệt đối không commit file .env.
# Tạo chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_DB=vuotthac
POSTGRES_USER=vuotthac
# Chỉ dùng chữ, số, - và _ vì mật khẩu nằm trong địa chỉ kết nối database
POSTGRES_PASSWORD=doi-mat-khau-nay

# Khoá tạo seed thử thách ngày. Đổi khoá giữa chừng thì seed của ngày đó đổi theo.
DAILY_SECRET=doi-khoa-nay

# Trên máy: dùng cổng riêng để tránh trùng (MCP for Unity đang dùng 8080).
# Trên server: SITE_ADDRESS=api.ten-mien.com, HTTP_PORT=80, HTTPS_PORT=443, ENABLE_DOCS=false
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443

# true thì mở trang tài liệu API tại /docs
ENABLE_DOCS=true
